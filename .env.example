# ---------------------------------------------------------------------------
# Dadi Maa Ke Nuskhe – environment variables
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Canonical origin of the deployed site (no trailing slash).
# Used for canonical URLs, hreflang, sitemap and Open Graph.
# Production example: https://dadimaakenuskhe.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics / verification (all optional, leave empty to disable) --------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML tag verification token (content="..." value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token (content="..." value)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Monetization (optional) ------------------------------------------------
# Google AdSense publisher ID, e.g. ca-pub-0000000000000000
# Only set this after your AdSense account has been approved.
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Newsletter / contact (optional) ---------------------------------------
# HTTPS endpoint that accepts a JSON POST: { "email": "...", "source": "..." }
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
# HTTPS endpoint that accepts a JSON POST from the contact form.
NEXT_PUBLIC_CONTACT_ENDPOINT=
